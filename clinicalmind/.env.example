# Copy to .env.local (git-ignored) and fill in.
# All of these are safe to ship in frontend code — Firestore security rules protect the data.

# ── Local testing with the Firebase emulators (no real project needed) ──
# Run `npm run emulators` in one terminal and `npm run dev` in another.
VITE_USE_EMULATORS=true

# ── Real Firebase project (Firebase Console → Project settings → Your apps → Web app) ──
# Set VITE_USE_EMULATORS=false and fill these in when you're ready to go live.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
